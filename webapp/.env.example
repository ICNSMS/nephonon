# Copy this file to webapp/.env and fill in the real MySQL credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=research_platform
MYSQL_PASSWORD=change_this_password
MYSQL_DATABASE=research_platform

# Login sessions remain valid for this many days (1-30).
AUTH_SESSION_DAYS=7

# Keep 0 for local http://127.0.0.1 development; use 1 behind production HTTPS.
AUTH_COOKIE_SECURE=0
